Vagrant.configure("2") do |config|

  config.vm.box = "bento/ubuntu-26.04"
  config.vm.synced_folder "confs", "/home/vagrant/confs"
	config.vm.boot_timeout = 600

  config.vm.define "mbekheirS", primary: true do |server|
    server.vm.hostname = "mbekheirS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
	  vb.name = "k3s-server-mbekheirS"
    end

    server.vm.provision "shell", path: "./scripts/init.sh"
  end

end