
Vagrant.configure("2") do |config|

  config.vm.box = "generic/ubuntu2204"

  config.vm.synced_folder "confs", "/vagrant/confs"

  config.vm.define "mbekheirS", primary: true do |master|
    master.vm.hostname = "mbekheirS"
    master.vm.network "private_network", ip: "192.168.56.10"
    
    master.vm.provider "libvirt" do |libvirt|
      libvirt.memory = 2048
      libvirt.cpus = 2
    end

    master.vm.provision "shell", path: "./scripts/master.sh"
  end

  config.vm.define "fzayaniSW" do |node|
    node.vm.hostname = "fzayaniSW"
    node.vm.network "private_network", ip: "192.168.56.11"
    
    node.vm.provider "libvirt" do |libvirt|
      libvirt.memory = 2048
      libvirt.cpus = 2
    end

    node.vm.provision "shell", path: "./scripts/agent.sh"
  end
end